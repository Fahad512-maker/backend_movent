APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the port `php artisan serve` actually runs on (and the
# frontend's NEXT_PUBLIC_API_URL) — Storage::url() uses this to build
# public file URLs (avatars, logos, etc.), so a wrong port here silently
# breaks every uploaded file's link even though the upload itself succeeds.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:3000

#
# ── Multi-environment redirect URIs ─────────────────────────────────────────
#
# Every *_REDIRECT_URI below is a BACKEND callback path (Google sends the
# browser straight there), never a frontend URL — and each var holds exactly
# ONE value, matching whichever single environment this particular .env file
# deploys. A comma-separated list does not work: only one redirect_uri can
# travel on a given OAuth request.
#
# The backend is served at {domain}/api in every environment (same domain as
# the frontend, no separate api. subdomain — confirmed 2026-09-22), so the
# three environments' values are:
#
#                        local dev                                  sandbox                                          production
#   GOOGLE_REDIRECT_URI        http://localhost/crm/public/api/user/auth/google/callback   https://sandbox.movent.io/api/user/auth/google/callback   https://movent.io/api/user/auth/google/callback
#   GOOGLE_ADMIN_REDIRECT_URI  http://localhost/crm/public/api/admin/auth/google/callback   https://sandbox.movent.io/api/admin/auth/google/callback  https://movent.io/api/admin/auth/google/callback
#   GOOGLE_DRIVE_REDIRECT_URI  http://localhost/crm/public/api/admin/google-drive/callback  https://sandbox.movent.io/api/admin/google-drive/callback https://movent.io/api/admin/google-drive/callback
#
# Register ALL SIX non-local URIs (sandbox + production, both Google login
# and Drive) as separate "Authorized redirect URIs" entries on their
# respective OAuth clients in Google Cloud Console — a client accepts many
# registered URIs at once, this app just only ever sends the one matching
# its own deployment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ADMIN_REDIRECT_URI=

# Google Drive company storage integration (Company Admin > Settings >
# Storage). A SEPARATE OAuth client from GOOGLE_CLIENT_ID above — do not
# reuse it. Create it in Google Cloud Console: APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application, enable the
# "Google Drive API" under APIs & Services > Library, and add scope
# https://www.googleapis.com/auth/drive.file (+ userinfo.email) under the
# OAuth consent screen. GOOGLE_DRIVE_REDIRECT_URI must exactly match one of
# that client's Authorized redirect URIs — see the three-environment table
# above.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# Internal attachment storage a company gets before uploads need Google
# Drive (Company Admin > Settings > Storage). See
# App\Services\CompanyStorageService.
COMPANY_ATTACHMENT_STORAGE_LIMIT_MB=10

# Free key from https://www.exchangerate-api.com/ — used to convert invoice
# payments into a currency the selected payment gateway actually supports.
EXCHANGE_RATE_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Super Admin console sign-in. Required — the app has no built-in default,
# so leaving these blank means nobody can sign in to /super-admin/login.
# Set a strong password here on every environment; it can then be rotated
# from Super Admin -> Account Settings.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# AI — every feature (project name/title suggestions, Client Portal's "AI
# Suggested IT Services", and the Client Portal assistant widget's intent
# routing and reply language) goes through App\Services\AiRouter, which tries
# three FREE providers in order and stops at the first that answers:
#
#   1. Groq       2. Gemini       3. OpenRouter
#
# A quota/rate-limit/429/daily-limit/model-unavailable/timeout/server error
# on one provider moves to the next automatically. If all three fail, the
# caller's own existing non-AI fallback is used (e.g. the Client Portal
# serves its built-in static catalog; project name generation falls back to
# Lead Title -> Requirement Document Title -> Invoice/Service Name ->
# "Client Project"; the portal assistant falls back to its deterministic
# keyword/regex routing and answers in English). Leaving ALL keys blank
# simply disables AI everywhere — every caller already tolerates that,
# nothing else breaks. The assistant in particular still pays invoices,
# lists projects and reaches a seller with every provider switched off; that
# is covered by tests/Feature/ClientAssistantWidgetTest.php, which runs with
# all three keys nulled.
#
# The assistant never sends client data to a model: the classifier sees only
# the sentence the client typed, and the language step sees only a sentence
# this app has already composed. No key is ever exposed to the browser —
# every call is server-side (App\Services\ClientAssistant\*).
#
# AI_FREE_ONLY documents (does not toggle) that every model configured below
# MUST be a free one — this app never falls through to a paid model.
AI_FREE_ONLY=true

# Provider #1 — https://console.groq.com/keys. OpenAI-compatible API; all
# hosted models are free to call. Default is a reasoning model (spends part
# of its token budget thinking before answering) — this app's callers
# already size max_tokens generously enough to account for that.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Provider #2 — https://aistudio.google.com/apikey. Free tier, rate-limited.
# Default is a reasoning model with "thinking" switched off in
# GeminiClient (thinkingBudget: 0) — this app wants short direct answers
# (a title, a JSON list), not a reasoned essay.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Provider #3 (last resort) — an OpenAI-compatible gateway in front of many
# model vendors (App\Services\AiServiceCatalogService,
# App\Services\LeadProjectTitleService).
#
# Model ids are 'vendor/model' (openai/gpt-4o, anthropic/claude-sonnet-4.5,
# google/gemini-2.5-flash). ':free' ids and the special 'openrouter/free'
# auto-router cost nothing but share a rate-limited pool, so they are not
# dependable for production.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional free-model fallback chain tried within this provider (comma-
# separated, tried in order) before AiRouter gives up entirely — skipping to
# the next on any quota/rate-limit/error. Leave blank to use just
# OPENROUTER_MODEL above. Every id must be free — never add a paid model.
OPENROUTER_FREE_MODELS=openrouter/free,nex-agi/nex-n2.5-pro:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free
